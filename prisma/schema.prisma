// Prisma schema — DevPath learning platform
// The five-category structure (Masterclass, Roadmaps, Courses, Resources,
// Simulators) is the core information architecture of the platform and is
// stored as configurable Category records so counts, wording, badges, order,
// icons and enable-state can all be managed without touching frontend code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A top-level resource category rendered in the Category Hub.
model Category {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  // Short line shown on the category card
  tagline        String         @default("")
  // Longer copy shown on the category landing view
  description    String         @default("")
  // Configurable wording used next to the live count, e.g. "workshops"
  countLabel     String         @default("items")
  // Locally managed icon path under /public
  icon           String         @default("")
  // Canonical category route (e.g. "/masterclass")
  route          String         @default("/")
  // Optional badge, e.g. "New"
  badge          String?
  badgeVariant   String         @default("default")
  // Accent key used for theming: amber | emerald | orange | rose | teal ...
  accent         String         @default("zinc")
  order          Int            @default(0)
  enabled        Boolean        @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          ResourceItem[]
}

// A single piece of publishable content inside a category.
// Counts shown in the hub are derived from published rows only.
model ResourceItem {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String    @default("")
  // Beginner | Intermediate | Advanced
  level       String    @default("Beginner")
  duration    String?
  tags        String    @default("")
  // JSON array of structured steps for roadmap-style items:
  // [{ "title": "...", "detail": "...", "hours": 12 }]
  steps       String    @default("")
  published   Boolean   @default(false)
  featured    Boolean   @default(false)
  order       Int       @default(0)
  views       Int       @default(0)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Course-level learning metadata for courses that ship real lesson content.
// Keyed by the course's ResourceItem slug so catalog + content stay linked
// without duplicating titles/levels (those live on the ResourceItem).
model Course {
  // Matches ResourceItem.slug of a "courses"-category item
  courseSlug    String   @id
  subtitle      String   @default("")
  // "Who this course is for" paragraph
  audience      String   @default("")
  // JSON string[] — learning outcomes ("What you'll learn")
  outcomes      String   @default("[]")
  // JSON string[] — slugs of prerequisite courses (rendered as links)
  prereqSlugs   String   @default("[]")
  // JSON string[] — technologies/tools covered
  technologies  String   @default("[]")
  // JSON string[] — skills covered
  skills        String   @default("[]")
  // JSON QuizQuestion[] — final assessment
  assessment    String   @default("[]")
  // Minimum score (0–100) required to pass the final assessment
  passScore     Int      @default(70)
  // JSON project spec (requirements, steps, evaluation criteria) or null
  project       String?
  // JSON {q, a}[] — interview preparation Q&A
  interviewQs   String   @default("[]")
  version       String   @default("1.0.0")
  // draft | review | published — only published exposes lessons to learners
  contentStatus String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lessons       Lesson[]
}

// A single lesson inside a course. Full teaching content is stored as
// structured JSON blocks (paragraphs, callouts, code, diagrams, quizzes…)
// rendered by reusable components — never hardcoded in JSX.
model Lesson {
  id         String   @id @default(cuid())
  courseSlug String
  course     Course   @relation(fields: [courseSlug], references: [courseSlug], onDelete: Cascade)
  // 1-based display order
  order      Int
  slug       String
  title      String
  // "After this lesson you will be able to…"
  objective  String   @default("")
  // "Why this matters" — real-world motivation
  why        String   @default("")
  minutes    Int      @default(15)
  xp         Int      @default(50)
  // JSON ContentBlock[] — the lesson body
  blocks     String   @default("[]")
  // JSON { prompt, hints[], solution, why } — Try It Yourself exercise
  exercise   String?
  // JSON QuizQuestion[] — end-of-lesson quiz
  quiz       String   @default("[]")
  summary    String   @default("")
  // "What's next" — bridge to the following lesson
  next       String   @default("")
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([courseSlug, order])
  @@unique([courseSlug, slug])
  @@index([courseSlug])
}

// Lightweight first-party analytics for category / item engagement.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  // category_view | card_click | item_view | search | lesson_view |
  // lesson_complete | quiz_attempt | assessment_pass | simulator_view |
  // challenge_complete
  type      String
  slug      String?
  label     String?
  createdAt DateTime @default(now())
}
